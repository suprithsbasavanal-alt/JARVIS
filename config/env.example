# ===================================================================
# Jarvis Centralized Environment Configuration Template
# ===================================================================

# Environment Mode (development, staging, production, testing)
ENVIRONMENT=development
DEBUG=true

# Feature Flags (override nested config using double underscores __)
FEATURES__ENABLE_VOICE=true
FEATURES__ENABLE_SANDBOX=true
FEATURES__ENABLE_RAG=true
FEATURES__ENABLE_TELEMETRY=true
FEATURES__ENABLE_GUARDRAILS=true
FEATURES__ENABLE_BACKGROUND_AUTOMATION=true
FEATURES__ENABLE_WEBSOCKET_STREAMING=true

# API Server Settings
API__HOST=0.0.0.0
API__PORT=8000
API__WEBSOCKET_PORT=8001
API__GRPC_PORT=50051
API__RATE_LIMIT_PER_MINUTE=120
API__REQUEST_TIMEOUT_SECONDS=30

# Model Provider Settings
MODEL__DEFAULT_PROVIDER=openai
MODEL__FALLBACK_PROVIDER=gemini
MODEL__DEFAULT_MODEL_NAME=gpt-4o
MODEL__EMBEDDING_MODEL_NAME=text-embedding-3-small
MODEL__TEMPERATURE=0.7
MODEL__MAX_TOKENS=4096
MODEL__STREAM_BY_DEFAULT=true

# API Keys
MODEL__OPENAI_API_KEY=your_openai_api_key_here
MODEL__ANTHROPIC_API_KEY=your_anthropic_api_key_here
MODEL__GEMINI_API_KEY=your_gemini_api_key_here

# Database Settings
DATABASE__POSTGRES_HOST=localhost
DATABASE__POSTGRES_PORT=5432
DATABASE__POSTGRES_DB=jarvis_db
DATABASE__POSTGRES_USER=jarvis_user
DATABASE__POSTGRES_PASSWORD=jarvis_password

# Vector Database (Qdrant)
DATABASE__QDRANT_HOST=localhost
DATABASE__QDRANT_PORT=6333
DATABASE__QDRANT_API_KEY=

# Cache Settings (Redis)
DATABASE__REDIS_HOST=localhost
DATABASE__REDIS_PORT=6379
DATABASE__REDIS_DB=0

# Security & Secrets
SECURITY__SECRET_KEY=change_this_to_a_secure_32_character_random_string_in_production
SECURITY__JWT_ALGORITHM=HS256
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=60
SECURITY__SANDBOX_EXECUTION_TIMEOUT_SECONDS=30
SECURITY__ENABLE_STRICT_GUARDRAILS=true

# Voice Engine Settings
VOICE__STT_PROVIDER=whisper
VOICE__TTS_PROVIDER=elevenlabs
VOICE__ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Logging Options
LOGGING__LEVEL=INFO
LOGGING__USE_JSON_FORMAT=false
LOGGING__LOG_TO_FILE=true
LOGGING__LOG_FILE_PATH=logs/jarvis.log
